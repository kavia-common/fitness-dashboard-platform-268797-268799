# Required
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitness_tracker
JWT_SECRET=change-me-in-prod

# Optional
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated list (no spaces). Include both localhost and 127.0.0.1 for local dev convenience.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
